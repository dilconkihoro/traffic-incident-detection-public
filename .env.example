# Copy to .env and set your own values. Placeholders below do not work as-is.

# Pipeline
TW_CONFIG=configs/pipeline.yaml
TW_WEIGHTS=weights/changeme-set-run-id/best.pt
TW_DATA_DIR=data

# Optional dataset mirrors and services (set only what you use; on Colab use Colab Secrets instead)
KAGGLE_USERNAME=changeme-set-your-own
KAGGLE_KEY=changeme-set-your-own
ROBOFLOW_API_KEY=changeme-set-your-own
HF_TOKEN=changeme-set-your-own

# Web dashboard (webapp/, supplementary per decision D-25; not required for the CLI)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TW_WEBAPP_SECRET_KEY=changeme-generate-a-real-one
# Generate both admin lines below with: python scripts/set_admin_password.py
TW_ADMIN_USERNAME=changeme-set-your-own
TW_ADMIN_PASSWORD_HASH=changeme-generate-a-real-one
# Optional overrides; sensible defaults are used if unset
# TW_WEBAPP_DB=webapp/backend/webapp.db
# TW_WEBAPP_UPLOADS_DIR=data/webapp_uploads
# TW_RUNS_DIR=reports
# TW_LOGIN_RATE_LIMIT_ATTEMPTS=5
# TW_LOGIN_RATE_LIMIT_WINDOW_S=300
# TW_SESSION_MAX_AGE_S=28800
# TW_MAX_UPLOAD_FRAMES=180
# TW_MAX_CONCURRENT_RUNS=1
# TW_MAX_CPU_THREADS=6
