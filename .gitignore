# Secrets
.env
.env.*
!.env.example

# Data and models (never committed; manifests and READMEs are)
data/*
!data/README.md
!data/MANIFEST.json
weights/*
!weights/README.md
runs/
*.pt
*.pth
*.onnx
*.engine
*.zip
*.tar
*.tar.gz

# Video and large media outputs
*.mp4
*.avi
*.mkv
reports/*
!reports/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Reference material (specification docx, institutional guides) stays local; the rest of docs/ is tracked
docs/reference/

# Review and scratch docs (may name unfixed gaps)
pr_*.md
docs/~*
*.tmp

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
